#!/usr/bin/env bash
# op-read - Read secrets via 1Password CLI
# Usage: op-read 'op://Vault/Item/Field'
#
# Uses `op read` (CLI auth via biometric/session).
# Unsets Connect env vars to prevent CLI from switching to Connect mode.
set -euo pipefail

unset OP_CONNECT_HOST OP_CONNECT_TOKEN OP_CONNECT_URL
exec op read "$@"
