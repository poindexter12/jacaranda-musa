#!/usr/bin/env bash
# secret-read - Project-level secret lookup wrapper.
#
# All Just recipes in this repo should go through this script (not `op-read`
# directly) when reading secrets. The indirection gives us a single seam to
# swap the backend — 1Password Connect today, a local file / hardcoded values
# tomorrow — without editing every callsite.
#
# Usage: secret-read 'op://Vault/Item/Field'
#
# Current behaviour: pass through to `op-read`, which talks to the
# 1Password Connect server. Override points to add later:
#   - SECRET_READ_FILE: read <URI>=<value> pairs from a local file
#   - SECRET_READ_MODE=local: hardcoded fallback for air-gapped work

set -euo pipefail

exec op-read "$@"
