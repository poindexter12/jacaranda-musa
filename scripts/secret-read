#!/usr/bin/env bash
# secret-read - Project-level secret lookup wrapper.
#
# All Just recipes in this repo go through this script (not `op-read`
# directly) when reading secrets. The indirection gives us a single seam to
# swap the backend.
#
# Current behaviour:
#   1. Try 1Password Connect via `op-read` (fast, works on homelab network).
#   2. On any failure, fall back to the local `op` CLI (desktop-app
#      integration, works off-network as long as the user is signed in).
#
# Usage: secret-read 'op://Vault/Item/Field'
#
# Environment:
#   SECRET_READ_DEBUG=1            Log which backend served each read to stderr.
#   SECRET_READ_DISABLE_CONNECT=1  Skip Connect and go straight to local `op`.
#                                  Handy for verifying the fallback works.

set -euo pipefail

uri="${1:-}"
if [[ -z "$uri" ]]; then
    echo "Usage: secret-read 'op://Vault/Item/Field'" >&2
    exit 1
fi

debug() {
    if [[ "${SECRET_READ_DEBUG:-0}" == "1" ]]; then
        echo "secret-read: $*" >&2
    fi
}

# Primary: 1Password Connect server (via op-read wrapper).
if [[ "${SECRET_READ_DISABLE_CONNECT:-0}" != "1" ]]; then
    if result=$(op-read "$uri" 2>/dev/null); then
        debug "$uri -> connect"
        printf '%s' "$result"
        exit 0
    fi
    debug "$uri connect failed, falling back to local op"
fi

# Fallback: local `op` CLI.
#
# The `op` binary prefers Connect when it sees these env vars, so we MUST
# unset them here — otherwise it just re-runs the same failing Connect call.
# We scope the unset to a subshell so we don't mutate the caller's env.
(
    unset OP_CONNECT_HOST OP_CONNECT_TOKEN OP_CONNECT_SERVERS OP_CONNECT_URL
    if ! command -v op >/dev/null 2>&1; then
        echo "secret-read: local 'op' CLI not found on PATH" >&2
        exit 1
    fi
    if result=$(op read "$uri" 2>/dev/null); then
        debug "$uri -> local op"
        printf '%s' "$result"
        exit 0
    fi
    echo "secret-read: failed to read $uri (tried Connect and local op)" >&2
    exit 1
)
