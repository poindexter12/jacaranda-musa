# {{ ansible_managed }}
# Twenty CRM environment variables
# Loaded by docker compose via env_file directive
#
# SECURITY NOTE: This file contains secrets (PG_DATABASE_URL, PG_DATABASE_PASSWORD,
# APP_SECRET, ENCRYPTION_KEY). It is deployed with mode 0600 (owner-only read).
# Do not change permissions or add this file to any shared volume.

# Database
PG_DATABASE_URL=postgres://postgres:{{ pg_password }}@db:5432/twenty
PG_DATABASE_PASSWORD={{ pg_password }}

# Application secret
APP_SECRET={{ app_secret }}

# At-rest secret encryption (versioned envelope, AES-256-GCM + HKDF-SHA256).
# Required from Twenty v2.5+. Falls back to APP_SECRET if unset, but a
# dedicated key is recommended so APP_SECRET can be rotated independently.
# Rotation: set FALLBACK_ENCRYPTION_KEY to the previous value during cutover.
ENCRYPTION_KEY={{ encryption_key }}

# Twenty API key for the rollup + webhook sidecars (provisioner key).
# Without it the nightly rollup dies at startup — this was missing until
# 2026-08-23 and the cron rollup had never actually run on this deployment.
TWENTY_API_KEY={{ twenty_api_key }}

# Redis
REDIS_URL=redis://redis:6379

# Frontend
FRONT_BASE_URL=https://{{ twenty_domain }}

# Storage
STORAGE_TYPE=local
