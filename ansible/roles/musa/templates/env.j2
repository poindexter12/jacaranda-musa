# {{ ansible_managed }}
# Twenty CRM environment variables
# Loaded by docker compose via env_file directive
#
# SECURITY NOTE: This file contains secrets (PG_DATABASE_URL, PG_DATABASE_PASSWORD,
# APP_SECRET). It is deployed with mode 0600 (owner-only read). Do not change
# permissions or add this file to any shared volume.

# Database
PG_DATABASE_URL=postgres://postgres:{{ pg_password }}@db:5432/twenty
PG_DATABASE_PASSWORD={{ pg_password }}

# Application secret
APP_SECRET={{ app_secret }}

# Redis
REDIS_URL=redis://redis:6379

# Frontend
FRONT_BASE_URL=https://{{ twenty_domain }}

# Storage
STORAGE_TYPE=local
