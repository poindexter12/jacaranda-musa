# {{ ansible_managed }}
# Twenty CRM — {{ twenty_domain }}
# Deployed by Ansible to {{ app_data_dir }}/docker-compose.yaml

x-logging: &default-logging
  driver: local
  options:
    max-size: "10m"
    max-file: "3"
    compress: "true"

services:

  db:
    image: postgres:16
    restart: unless-stopped
    volumes:
      - db-data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: {{ pg_password }}
      POSTGRES_DB: twenty
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging: *default-logging

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --maxmemory-policy noeviction
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 5s
    logging: *default-logging

  server:
    image: twentycrm/twenty:{{ twenty_tag }}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    ports:
      - "3000:3000"
    volumes:
      - server-local-data:/app/packages/twenty-server/.local-storage
    env_file: .env
    environment:
      NODE_PORT: 3000
      SERVER_URL: https://{{ twenty_domain }}
    healthcheck:
      test: ["CMD", "curl", "-sf", "--max-time", "5", "http://localhost:3000/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
      # Twenty 2.31 needs ~135s to finish booting. At the old 60s grace the
      # container was declared unhealthy at ~110s, so the restart handler's
      # `up -d --force-recreate` aborted every service with
      # `depends_on: service_healthy` and left the stack half-started.
      # Failures during start_period do not count toward `retries`.
      start_period: 180s
    logging: *default-logging

  worker:
    image: twentycrm/twenty:{{ twenty_tag }}
    restart: unless-stopped
    command: yarn worker:prod
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      server:
        condition: service_healthy
    env_file: .env
    environment:
      DISABLE_DB_MIGRATIONS: "true"
      DISABLE_CRON_JOBS_REGISTRATION: "true"
    logging: *default-logging

  backup:
    image: ghcr.io/poindexter12/musa-project-twenty-crm/backup:{{ backup_tag }}
    container_name: twenty-backup
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    volumes:
      - backups:/backups:rw
    environment:
      PGHOST: db
      PGPORT: "5432"
      PGUSER: postgres
      PGPASSWORD: {{ pg_password }}
      PGDATABASE: twenty
      BACKUP_DIR: /backups
      RETENTION_DAYS: "7"
    logging: *default-logging

  # TWENTY_API_KEY for rollup and the webhook services comes from .env
  # (env_file) — see env.j2. Never inline it here.
  rollup:
    image: ghcr.io/poindexter12/musa-project-twenty-crm/rollup:{{ rollup_tag }}
    container_name: twenty-rollup
    restart: unless-stopped
    depends_on:
      server:
        condition: service_healthy
    env_file: .env
    environment:
      TWENTY_API_URL: http://server:3000
      CRON_SCHEDULE: "0 2 * * *"
      TZ: {{ timezone }}
      WEBHOOK_ROLLUP_MODE: disabled
    logging: *default-logging

  webhook-receiver:
    image: ghcr.io/poindexter12/musa-project-twenty-crm/webhook-receiver:{{ webhook_tag }}
    container_name: twenty-webhook-receiver
    restart: unless-stopped
    depends_on:
      server:
        condition: service_healthy
      redis:
        condition: service_healthy
    ports:
      - "4001:5000"
    env_file: .env
    environment:
      TWENTY_API_URL: http://server:3000
      WEBHOOK_ROLLUP_MODE: disabled
      REDIS_URL: redis://redis:6379/0
      CIRCUIT_BREAKER_FAIL_MAX: "5"
      CIRCUIT_BREAKER_RESET_TIMEOUT: "60"
    healthcheck:
      test: ["CMD", "curl", "-sf", "--max-time", "5", "http://localhost:5000/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging: *default-logging

  webhook-worker:
    image: ghcr.io/poindexter12/musa-project-twenty-crm/webhook-receiver:{{ webhook_tag }}
    container_name: twenty-webhook-worker
    restart: unless-stopped
    command: python -m webhook_receiver.worker
    working_dir: /app
    depends_on:
      redis:
        condition: service_healthy
      server:
        condition: service_healthy
    env_file: .env
    environment:
      TWENTY_API_URL: http://server:3000
      WEBHOOK_ROLLUP_MODE: disabled
      REDIS_URL: redis://redis:6379/0
    logging: *default-logging

  # The only reverse proxy. Reachable solely from inside the compose network —
  # cloudflared is the only way in, so Caddy speaks plain HTTP on :80 and there
  # is no certificate anywhere in this stack.
  caddy:
    image: caddy:2-alpine
    container_name: twenty-caddy
    restart: unless-stopped
    depends_on:
      server:
        condition: service_healthy
    volumes:
      - {{ app_data_dir }}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    logging: *default-logging

  # The Cloudflare Tunnel. Previously a DOCKER_MOD inside SWAG, which meant
  # every restart ran certbot for an unused certificate before the tunnel came
  # back — see CLAUDE.md "Ingress Migration". Everything terminates at Caddy.
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: twenty-cloudflared
    restart: unless-stopped
    depends_on:
      - caddy
    command: tunnel --no-autoupdate --config /etc/cloudflared/config.yml run
    volumes:
      - {{ app_data_dir }}/cloudflared:/etc/cloudflared:ro
    logging: *default-logging

volumes:
  db-data:
    driver: local
  server-local-data:
    driver: local
  backups:
    driver: local
  caddy-data:
    driver: local
  caddy-config:
    driver: local
