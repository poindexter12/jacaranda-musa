# {{ ansible_managed }}
## Cloudflare Tunnel ingress — {{ cf_tunnel_name }}
##
## cloudflared runs as its own container now. It used to be a DOCKER_MOD inside
## SWAG, which meant a restart ran certbot before the tunnel came back up.
##
## Everything terminates at Caddy; there is no other origin.

tunnel: {{ cf_tunnel_id }}
credentials-file: /etc/cloudflared/credentials.json
no-autoupdate: true

ingress:
  - hostname: {{ twenty_domain }}
    service: http://caddy:80
{% for alias in twenty_domain_aliases | default([]) %}
  - hostname: {{ alias }}
    service: http://caddy:80
{% endfor %}
  - service: http_status:404
